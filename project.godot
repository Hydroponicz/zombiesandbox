; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Zombie Sandbox"
config/version="0.0.1"
run/main_scene="res://levels/test_range/test_range.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")

[autoload]

GameInput="*res://game/core/input/GameInput.cs"
Ballistics="*res://game/combat/ballistics/Ballistics.cs"
WorldClock="*res://game/world/WorldClock.cs"
Factions="*res://game/ai/factions/FactionRelations.cs"

[dotnet]

project/assembly_name="Zombie Sandbox"

[layer_names]

3d_render/layer_1="world"
3d_render/layer_2="first_person_hidden"
3d_physics/layer_1="world"
3d_physics/layer_2="characters"
3d_physics/layer_3="items"
3d_physics/layer_4="hitboxes"

[navigation]

world/region_use_async_iterations=false
3d/default_cell_height=0.1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true
